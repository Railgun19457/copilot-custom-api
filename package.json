{
  "name": "copilot-custom-api",
  "displayName": "Copilot Custom API",
  "description": "Connect your own model API endpoints to GitHub Copilot Chat.",
  "version": "0.6.0",
  "publisher": "Railgun19457",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.145.0"
  },
  "categories": [
    "AI",
    "Machine Learning"
  ],
  "extensionKind": [
    "ui"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc -p .",
    "test": "npm run compile && node --test test/*.test.cjs",
    "test:vscode": "npm run compile && node test/run-vscode.cjs",
    "package": "vsce package --no-dependencies --allow-missing-repository --skip-license",
    "vscode:prepublish": "npm run compile"
  },
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "copilot-custom-api",
        "displayName": "Copilot Custom API"
      }
    ],
    "commands": [
      {
        "command": "copilotCustomApi.openManager",
        "title": "%command.openManager%",
        "category": "Copilot Custom API",
        "icon": "$(open-preview)"
      },
      {
        "command": "copilotCustomApi.newProvider",
        "title": "%command.newProvider%",
        "category": "Copilot Custom API",
        "icon": "$(add)"
      },
      {
        "command": "copilotCustomApi.openProvider",
        "title": "%command.openProvider%",
        "category": "Copilot Custom API"
      },
      {
        "command": "copilotCustomApi.manage",
        "title": "%command.manageWizard%",
        "category": "Copilot Custom API"
      },
      {
        "command": "copilotCustomApi.addProvider",
        "title": "%command.addWizard%",
        "category": "Copilot Custom API"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "copilotCustomApi",
          "title": "Copilot Custom API",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "copilotCustomApi": [
        {
          "id": "copilotCustomApi.providers",
          "name": "%view.providers%"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "copilotCustomApi.openManager",
          "when": "view == copilotCustomApi.providers",
          "group": "navigation@1"
        },
        {
          "command": "copilotCustomApi.newProvider",
          "when": "view == copilotCustomApi.providers",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        { "command": "copilotCustomApi.openProvider", "when": "false" }
      ]
    },
    "viewsWelcome": [
      {
        "view": "copilotCustomApi.providers",
        "contents": "%view.welcome%"
      }
    ],
    "configuration": {
      "title": "Copilot Custom API",
      "properties": {
        "copilotCustomApi.language": {
          "type": "string",
          "enum": ["auto", "zh-cn", "en"],
          "default": "auto",
          "scope": "application",
          "description": "%setting.language%"
        },
        "copilotCustomApi.providers": {
          "type": "object",
          "default": {},
          "scope": "application",
          "markdownDescription": "%setting.providers%"
        }
      }
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/vscode": "1.145.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "4.1.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@vscode/vsce": {
      "minimatch": "11.0.1"
    }
  }
}
